---
interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;

const telegramUrl = `https://t.me/share/url?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`;
const whatsappUrl = `https://wa.me/?text=${encodeURIComponent(`${title}\n${url}`)}`;
---

<div class="share-buttons" data-share data-url={url} data-title={title}>
  <span class="share-label">اشتراک‌گذاری:</span>

  <a
    class="share-btn share-telegram"
    href={telegramUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="اشتراک‌گذاری در تلگرام"
    title="اشتراک‌گذاری در تلگرام"
  >
    <svg viewBox="0 0 240 240" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="120" cy="120" r="120" fill="#29A9EA"/>
      <path
        fill="#fff"
        d="M174.6 68.3 51.2 116.4c-8.4 3.4-8.4 8.1-1.6 10.1l31.6 9.9 12.2 37.4c1.4 3.9 0.7 5.5 4.9 5.5 3.2 0 4.6-1.5 6.4-3.2 1.1-1.1 8.7-8.4 17.2-16.7l35.7 26.4c6.6 3.6 11.3 1.8 13-6.1l23.4-110.5c2.4-9.7-3.7-14.1-10.4-11.9Zm-19.3 30.9-63.7 57.6-2.6 27.8-13.1-40.2 96-58.4c4.5-2.7 8.6-1.2 5.2 1.8Z"
      />
    </svg>
  </a>

  <a
    class="share-btn share-whatsapp"
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="اشتراک‌گذاری در واتساپ"
    title="اشتراک‌گذاری در واتساپ"
  >
    <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="16" cy="16" r="16" fill="#25D366"/>
      <path
        fill="#fff"
        d="M23.5 8.5a10 10 0 0 0-16.4 11.3L6 25l5.4-1.4A10 10 0 0 0 23.5 8.5Zm-7.5 15.2a8.3 8.3 0 0 1-4.2-1.1l-.3-.2-3.1.8.8-3-.2-.3a8.3 8.3 0 1 1 15.5-4.2 8.3 8.3 0 0 1-8.5 8Zm4.5-6.2c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.2-.7.8-.8 1-.2.2-.3.2-.5.1a6.8 6.8 0 0 1-2-1.2 7.5 7.5 0 0 1-1.4-1.7c-.1-.2 0-.4.1-.5l.4-.4.2-.4a.5.5 0 0 0 0-.4c-.1-.1-.6-1.4-.8-1.9-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2c0 1.3.9 2.6 1.1 2.8.1.2 2 3 4.8 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"
      />
    </svg>
  </a>

  <button
    class="share-btn share-copy"
    type="button"
    data-copy-link
    aria-label="کپی لینک خبر"
    title="کپی لینک خبر"
  >
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="9" y="9" width="12" height="12" rx="2"/>
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
    </svg>
  </button>

  <button
    class="share-btn share-native"
    type="button"
    data-native-share
    aria-label="اشتراک‌گذاری"
    title="اشتراک‌گذاری"
    hidden
  >
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="18" cy="5" r="3"/>
      <circle cx="6" cy="12" r="3"/>
      <circle cx="18" cy="19" r="3"/>
      <path d="M8.6 13.5 15.4 17.5M15.4 6.5 8.6 10.5"/>
    </svg>
  </button>

  <span class="copy-feedback" data-copy-feedback>لینک کپی شد ✓</span>
</div>

<script>
  const containers = document.querySelectorAll("[data-share]");

  containers.forEach((container) => {
    const url = container.getAttribute("data-url") || "";
    const title = container.getAttribute("data-title") || "";

    const copyBtn = container.querySelector("[data-copy-link]");
    const feedback = container.querySelector("[data-copy-feedback]");

    copyBtn?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(url);
        feedback?.classList.add("visible");
        setTimeout(() => feedback?.classList.remove("visible"), 2000);
      } catch {
        // clipboard API unavailable — silently ignore
      }
    });

    const nativeBtn = container.querySelector("[data-native-share]");
    if (nativeBtn && navigator.share) {
      nativeBtn.removeAttribute("hidden");
      nativeBtn.addEventListener("click", () => {
        navigator.share({ title, url }).catch(() => {});
      });
    }
  });
</script>

<style>
  .share-buttons {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin: 24px 0;
    padding: 14px 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .share-label {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .share-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 7px;
    border: none;
    border-radius: 50%;
    background: var(--color-background);
    color: var(--color-text);
    cursor: pointer;
    transition: transform 150ms ease;
  }

  .share-btn:hover {
    transform: scale(1.08);
  }

  .share-btn svg {
    width: 100%;
    height: 100%;
  }

  .share-copy,
  .share-native {
    border: 1px solid var(--color-border);
  }

  .copy-feedback {
    display: none;
    color: var(--color-primary-dark);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .copy-feedback.visible {
    display: inline-block;
  }
</style>
