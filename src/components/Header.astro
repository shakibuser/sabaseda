---
const menuItems = [
  { label: "خانه", href: "/" },
  { label: "آخرین اخبار", href: "/news/" },
  { label: "درباره ما", href: "/about/" }
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="صبا رسانه، صفحه اصلی">
      <img
        class="brand-logo"
        src="/images/logo/logo.png"
        alt="لوگوی صبا رسانه"
        width="44"
        height="44"
      />
      <span class="brand-text">
        <span class="brand-name">صبا رسانه</span>
        <span class="brand-tagline">صدای حقیقت، مطالبه عدالت</span>
      </span>
    </a>

    <div class="header-actions">
      <nav id="main-navigation" class="main-navigation" aria-label="منوی اصلی" data-menu>
        <ul>
          {menuItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={{
                  active: item.href === "/" ? currentPath === "/" : currentPath.startsWith(item.href)
                }}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="icon-group">
        <a
          class="telegram-link"
          href="https://t.me/saba_rasanehh"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="کانال تلگرام صبا رسانه"
          title="عضویت در کانال تلگرام"
        >
          <svg viewBox="0 0 240 240" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="120" cy="120" r="120" fill="#29A9EA"/>
            <path
              fill="#fff"
              d="M174.6 68.3 51.2 116.4c-8.4 3.4-8.4 8.1-1.6 10.1l31.6 9.9 12.2 37.4c1.4 3.9 0.7 5.5 4.9 5.5 3.2 0 4.6-1.5 6.4-3.2 1.1-1.1 8.7-8.4 17.2-16.7l35.7 26.4c6.6 3.6 11.3 1.8 13-6.1l23.4-110.5c2.4-9.7-3.7-14.1-10.4-11.9Zm-19.3 30.9-63.7 57.6-2.6 27.8-13.1-40.2 96-58.4c4.5-2.7 8.6-1.2 5.2 1.8Z"
            />
          </svg>
        </a>

        <button
          class="theme-toggle"
          type="button"
          aria-label="تغییر حالت روشن و تیره"
          data-theme-toggle
        >
          🌓
        </button>

        <button
          class="menu-toggle"
          type="button"
          aria-label="باز کردن منو"
          aria-expanded="false"
          aria-controls="main-navigation"
          data-menu-toggle
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector("[data-menu-toggle]");
  const menu = document.querySelector("[data-menu]");

  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!open));
      if (open) menu.removeAttribute("data-open");
      else menu.setAttribute("data-open", "");
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        toggle.setAttribute("aria-expanded", "false");
        menu.removeAttribute("data-open");
      });
    });
  }

  const themeToggle = document.querySelector("[data-theme-toggle]");
  const root = document.documentElement;
  const STORAGE_KEY = "saba-theme";

  const applyTheme = (theme) => {
    if (theme === "dark") root.setAttribute("data-theme", "dark");
    else root.removeAttribute("data-theme");
  };

  const savedTheme = localStorage.getItem(STORAGE_KEY);
  if (savedTheme) applyTheme(savedTheme);

  themeToggle?.addEventListener("click", () => {
    const isDark = root.getAttribute("data-theme") === "dark";
    const next = isDark ? "light" : "dark";
    applyTheme(next);
    localStorage.setItem(STORAGE_KEY, next);
  });
</script>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-background);
  }

  .header-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 76px;
    gap: 20px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .brand-logo {
    flex-shrink: 0;
    border-radius: 50%;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .brand-name {
    font-size: 1.35rem;
    font-weight: 800;
  }

  .brand-tagline {
    margin-top: 4px;
    color: var(--color-text-muted);
    font-size: 0.72rem;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .main-navigation ul {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .main-navigation a {
    position: relative;
    display: block;
    padding: 9px 13px;
    border-radius: 8px;
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
  }

  .main-navigation a::after {
    content: "";
    position: absolute;
    right: 13px;
    left: 13px;
    bottom: 3px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-primary);
    transform: scaleX(0);
    transition: transform 200ms ease;
  }

  .main-navigation a:hover,
  .main-navigation a.active {
    background: var(--color-surface);
    color: var(--color-primary-dark);
  }

  .main-navigation a:hover::after,
  .main-navigation a.active::after {
    transform: scaleX(1);
  }

  .icon-group {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-inline-start: 12px;
    border-inline-start: 1px solid var(--color-border);
  }

  .menu-toggle,
  .theme-toggle,
  .telegram-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    padding: 8px;
    border: none;
    border-radius: 8px;
    background: transparent;
    cursor: pointer;
    transition: background 150ms ease;
  }

  .menu-toggle:hover,
  .theme-toggle:hover,
  .telegram-link:hover {
    background: var(--color-surface);
  }

  .telegram-link svg {
    width: 100%;
    height: 100%;
  }

  .menu-toggle {
    display: none;
  }

  .theme-toggle {
    font-size: 1.05rem;
    line-height: 1;
  }

  .menu-toggle span {
    display: block;
    height: 2px;
    margin: 5px 0;
    background: currentColor;
  }

  @media (max-width: 760px) {
    .header-actions {
      gap: 10px;
    }

    .icon-group {
      padding-inline-start: 8px;
      gap: 2px;
    }

    .menu-toggle {
      display: flex;
    }

    .main-navigation {
      position: absolute;
      top: calc(100% + 1px);
      right: 12px;
      left: 12px;
      display: none;
      padding: 8px;
      border: 1px solid var(--color-border);
      border-radius: 10px;
      background: var(--color-background);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    }

    .main-navigation[data-open] {
      display: block;
    }

    .main-navigation ul {
      display: block;
    }

    .main-navigation li + li {
      margin-top: 2px;
    }
  }
</style>
