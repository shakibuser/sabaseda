---
const menuItems = [
  { label: "خانه", href: "/" },
  { label: "آخرین اخبار", href: "/news/" },
  { label: "درباره ما", href: "/about/" }
];

const currentPath = Astro.url.pathname;
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="صبا رسانه، صفحه اصلی">
      <img
        class="brand-logo"
        src="/images/logo/logo.png"
        alt="لوگوی صبا رسانه"
        width="44"
        height="44"
      />
      <span class="brand-text">
        <span class="brand-name">صبا رسانه</span>
        <span class="brand-tagline">صدای حقیقت، مطالبه عدالت</span>
      </span>
    </a>

    <div class="header-actions">
      <nav id="main-navigation" class="main-navigation" aria-label="منوی اصلی" data-menu>
        <ul>
          {menuItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={{
                  active: item.href === "/" ? currentPath === "/" : currentPath.startsWith(item.href)
                }}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="icon-group">
        <a
          class="icon-btn search-link"
          href="/news/#search"
          aria-label="جست‌وجوی خبر"
          title="جست‌وجوی خبر"
        >
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.3-4.3"/>
          </svg>
        </a>

        <button
          class="icon-btn theme-toggle"
          type="button"
          aria-label="تغییر حالت روشن و تیره"
          data-theme-toggle
        >
          <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4.5"/>
            <path d="M12 2.5v2.4M12 19.1v2.4M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M2.5 12h2.4M19.1 12h2.4M4.9 19.1l1.7-1.7M17.4 6.6l1.7-1.7"/>
          </svg>
          <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.5 14.5a8.5 8.5 0 1 1-9-11 6.8 6.8 0 0 0 9 11Z"/>
          </svg>
        </button>

        <button
          class="icon-btn menu-toggle"
          type="button"
          aria-label="باز کردن منو"
          aria-expanded="false"
          aria-controls="main-navigation"
          data-menu-toggle
        >
          <span class="menu-toggle-bars" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>
      </div>
    </div>
  </div>

  <div class="menu-backdrop" data-menu-backdrop hidden></div>
</header>

<script>
  const toggle = document.querySelector("[data-menu-toggle]");
  const menu = document.querySelector("[data-menu]");
  const backdrop = document.querySelector("[data-menu-backdrop]");

  const closeMenu = () => {
    toggle?.setAttribute("aria-expanded", "false");
    menu?.removeAttribute("data-open");
    if (backdrop) backdrop.hidden = true;
    document.body.classList.remove("menu-open");
  };

  const openMenu = () => {
    toggle?.setAttribute("aria-expanded", "true");
    menu?.setAttribute("data-open", "");
    if (backdrop) backdrop.hidden = false;
    document.body.classList.add("menu-open");
  };

  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      if (isOpen) closeMenu();
      else openMenu();
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    backdrop?.addEventListener("click", closeMenu);

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeMenu();
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth > 760) closeMenu();
    });
  }

  const themeToggle = document.querySelector("[data-theme-toggle]");
  const root = document.documentElement;
  const STORAGE_KEY = "saba-theme";

  const applyTheme = (theme) => {
    if (theme === "dark") root.setAttribute("data-theme", "dark");
    else root.removeAttribute("data-theme");
  };

  const savedTheme = localStorage.getItem(STORAGE_KEY);
  if (savedTheme) applyTheme(savedTheme);

  themeToggle?.addEventListener("click", () => {
    const isDark = root.getAttribute("data-theme") === "dark";
    const next = isDark ? "light" : "dark";
    applyTheme(next);
    localStorage.setItem(STORAGE_KEY, next);
  });

  const header = document.querySelector("[data-site-header]");
  const updateScrolledState = () => {
    header?.classList.toggle("is-scrolled", window.scrollY > 6);
  };
  updateScrolledState();
  window.addEventListener("scroll", updateScrolledState, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-background);
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0);
    transition: box-shadow 220ms ease, background-color 200ms ease, border-color 200ms ease;
  }

  .site-header.is-scrolled {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .header-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 76px;
    gap: 20px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    color: inherit;
    text-decoration: none;
    border-radius: 10px;
  }

  .brand-logo {
    flex-shrink: 0;
    border-radius: 50%;
    transition: transform 200ms ease;
  }

  .brand:hover .brand-logo {
    transform: rotate(-6deg) scale(1.04);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .brand-name {
    font-size: 1.35rem;
    font-weight: 800;
  }

  .brand-tagline {
    margin-top: 4px;
    color: var(--color-text-muted);
    font-size: 0.72rem;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .main-navigation ul {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .main-navigation a {
    position: relative;
    display: block;
    padding: 9px 13px;
    border-radius: 8px;
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .main-navigation a::after {
    content: "";
    position: absolute;
    right: 13px;
    left: 13px;
    bottom: 3px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-primary);
    transform: scaleX(0);
    transition: transform 200ms ease;
  }

  .main-navigation a:hover,
  .main-navigation a.active {
    background: var(--color-surface);
    color: var(--color-accent-ink);
  }

  .main-navigation a:hover::after,
  .main-navigation a.active::after {
    transform: scaleX(1);
  }

  .icon-group {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-inline-start: 12px;
    border-inline-start: 1px solid var(--color-border);
  }

  /* All header icon controls share one rule so none of them can silently
     fall back to the browser's default button color (the cause of the
     hamburger icon disappearing in some browser/theme combinations). */
  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    padding: 8px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .icon-btn svg {
    width: 100%;
    height: 100%;
  }

  .icon-btn:hover {
    background: var(--color-surface);
  }

  .icon-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .theme-toggle {
    position: relative;
  }

  .theme-icon {
    position: absolute;
    inset: 8px;
    transition: opacity 220ms ease, transform 320ms ease;
  }

  .theme-icon-sun {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .theme-icon-moon {
    opacity: 0;
    transform: rotate(-60deg) scale(0.5);
  }

  :global(html[data-theme="dark"]) .theme-icon-sun {
    opacity: 0;
    transform: rotate(60deg) scale(0.5);
  }

  :global(html[data-theme="dark"]) .theme-icon-moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .menu-toggle {
    display: none;
  }

  .menu-toggle-bars {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
  }

  .menu-toggle-bars span {
    position: absolute;
    right: 0;
    left: 0;
    display: block;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 220ms ease, opacity 220ms ease, top 220ms ease;
  }

  .menu-toggle-bars span:nth-child(1) {
    top: 30%;
  }

  .menu-toggle-bars span:nth-child(2) {
    top: 50%;
    transform: translateY(-50%);
  }

  .menu-toggle-bars span:nth-child(3) {
    top: 70%;
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle-bars span:nth-child(1) {
    top: 50%;
    transform: translateY(-50%) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle-bars span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle-bars span:nth-child(3) {
    top: 50%;
    transform: translateY(-50%) rotate(-45deg);
  }

  .menu-backdrop {
    display: none;
  }

  @media (max-width: 760px) {
    .header-actions {
      gap: 10px;
    }

    .icon-group {
      padding-inline-start: 8px;
      gap: 2px;
    }

    .menu-toggle {
      display: flex;
    }

    .main-navigation {
      position: absolute;
      top: calc(100% + 10px);
      right: 12px;
      left: 12px;
      z-index: 31;
      display: block;
      padding: 8px;
      border: 1px solid var(--color-border);
      border-radius: 12px;
      background: var(--color-surface);
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.16);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition: opacity 200ms ease, transform 200ms ease, visibility 200ms;
    }

    .main-navigation[data-open] {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .main-navigation ul {
      display: block;
    }

    .main-navigation li + li {
      margin-top: 2px;
    }

    .main-navigation a {
      padding: 12px 14px;
    }

    .menu-backdrop {
      position: fixed;
      inset: 0;
      z-index: 25;
      display: block;
      background: rgba(0, 0, 0, 0.32);
      backdrop-filter: blur(2px);
      animation: fade-in 200ms ease;
    }

    .menu-backdrop[hidden] {
      display: none;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-logo,
    .main-navigation a,
    .theme-icon,
    .menu-toggle-bars span,
    .main-navigation,
    .site-header {
      transition: none;
    }
  }
</style>

<style is:global>
  body.menu-open {
    overflow: hidden;
  }

  @media (min-width: 761px) {
    body.menu-open {
      overflow: auto;
    }
  }
</style>
