---
import { formatPersianDateTime, toIsoDateTime } from "../utils/date";

interface Props {
  title: string;
  summary: string;
  category: string;
  date: string;
  image: string;
  imageAlt: string;
  href: string;
  featured?: boolean;
}

const {
  title,
  summary,
  category,
  date,
  image,
  imageAlt,
  href,
  featured = false
} = Astro.props;

const isoDate = toIsoDateTime(date);
const persianDate = formatPersianDateTime(date);
const fallbackImage = "/images/news/sample-news.svg";
---

<article class:list={["news-card", { featured }]}>
  <a class="news-link" href={href}>
    <div class="news-image">
      <img
        src={image}
        alt={imageAlt}
        width="1200"
        height="675"
        loading={featured ? "eager" : "lazy"}
        decoding="async"
        onerror={`this.onerror=null;this.src='${fallbackImage}';`}
      />
    </div>

    <div class="news-content">
      <div class="news-meta">
        <span class="news-category">{category}</span>
        <time datetime={isoDate}>{persianDate}</time>
      </div>

      <h2 class="news-title">{title}</h2>
      <p class="news-summary">{summary}</p>
    </div>
  </a>
</article>

<style>
  .news-card {
    border-bottom: 1px solid var(--color-border);
  }

  .news-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .news-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-border);
  }

  .news-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 180ms ease;
  }

  .news-link:hover .news-image img {
    transform: scale(1.015);
  }

  .news-content {
    padding: 18px 0 25px;
  }

  .news-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  .news-category {
    color: var(--color-primary-dark);
    font-weight: 700;
  }

  .news-title {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .news-summary {
    margin: 8px 0 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.9;
  }

  .news-card.featured .news-title {
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
  }

  .news-card.featured .news-content {
    padding-bottom: 30px;
  }
</style>
