---
---

<div class="social-sidebar" data-social-sidebar>
  <button
    class="sidebar-toggle"
    type="button"
    data-sidebar-toggle
    aria-label="نمایش یا پنهان‌کردن شبکه‌های اجتماعی"
    aria-expanded="true"
    title="شبکه‌های اجتماعی"
  >
    <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
      <path
        d="M6 15l6-6 6 6"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </button>

  <div class="sidebar-icons" data-sidebar-icons aria-label="شبکه‌های اجتماعی صبا رسانه">
    <a
      class="sidebar-icon"
      href="https://instagram.com/saba_rasanehh_"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="اینستاگرام صبا رسانه"
      title="اینستاگرام"
    >
      <img src="/images/instagram.png" alt="اینستاگرام" width="26" height="26" loading="lazy" />
    </a>

    <a
      class="sidebar-icon"
      href="https://t.me/saba_rasanehh"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="تلگرام صبا رسانه"
      title="تلگرام"
    >
      <svg viewBox="0 0 240 240" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="120" cy="120" r="120" fill="#29A9EA" />
        <path
          fill="#fff"
          d="M174.6 68.3 51.2 116.4c-8.4 3.4-8.4 8.1-1.6 10.1l31.6 9.9 12.2 37.4c1.4 3.9 0.7 5.5 4.9 5.5 3.2 0 4.6-1.5 6.4-3.2 1.1-1.1 8.7-8.4 17.2-16.7l35.7 26.4c6.6 3.6 11.3 1.8 13-6.1l23.4-110.5c2.4-9.7-3.7-14.1-10.4-11.9Zm-19.3 30.9-63.7 57.6-2.6 27.8-13.1-40.2 96-58.4c4.5-2.7 8.6-1.2 5.2 1.8Z"
        />
      </svg>
    </a>

    <a
      class="sidebar-icon"
      href="https://ble.ir/saba_rasanehh"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="بله صبا رسانه"
      title="بله"
    >
      <img src="/images/bale.png" alt="بله" width="26" height="26" loading="lazy" />
    </a>

    <a
      class="sidebar-icon"
      href="https://rubika.ir/saba_rasanehh"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="روبیکا صبا رسانه"
      title="روبیکا"
    >
      <img src="/images/rubika.png" alt="روبیکا" width="26" height="26" loading="lazy" />
    </a>

    <a
      class="sidebar-icon"
      href="https://x.com/saba_radanehh"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="ایکس (توییتر) صبا رسانه"
      title="X"
    >
      <svg viewBox="0 0 240 240" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="120" cy="120" r="120" fill="#000" />
        <path
          fill="#fff"
          d="M67 62h26.5l30.3 41.4L157 62h20l-40.8 47.6L182 178h-26.5l-33.1-45.3L82 178H62l43.2-50.4L67 62Zm14.9 14.7 78 101.6h13.3l-78-101.6H81.9Z"
        />
      </svg>
    </a>

    <a
      class="sidebar-icon"
      href="/rss.xml"
      aria-label="فید RSS صبا رسانه"
      title="RSS"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path
          fill="var(--color-primary-dark)"
          d="M4 11a9 9 0 0 1 9 9h-2.5A6.5 6.5 0 0 0 4 13.5V11Zm0-5a14 14 0 0 1 14 14h-2.5A11.5 11.5 0 0 0 4 8.5V6Zm2 11.5A2.5 2.5 0 1 1 6 22.5a2.5 2.5 0 0 1 0-5Z"
        />
      </svg>
    </a>
  </div>
</div>

<script>
  const sidebar = document.querySelector("[data-social-sidebar]");
  const toggle = sidebar?.querySelector("[data-sidebar-toggle]");

  const COLLAPSE_KEY = "saba-social-sidebar-collapsed";

  if (localStorage.getItem(COLLAPSE_KEY) === "1") {
    sidebar?.classList.add("is-collapsed");
    toggle?.setAttribute("aria-expanded", "false");
  }

  toggle?.addEventListener("click", () => {
    const collapsed = sidebar?.classList.toggle("is-collapsed");
    toggle.setAttribute("aria-expanded", String(!collapsed));
    localStorage.setItem(COLLAPSE_KEY, collapsed ? "1" : "0");
  });
</script>

<style>
  .social-sidebar {
    position: fixed;
    top: 50%;
    left: 16px;
    transform: translateY(-50%);
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .sidebar-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-background);
    color: var(--color-text-muted);
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
  }

  .sidebar-toggle svg {
    transition: transform 0.25s ease;
  }

  .social-sidebar.is-collapsed .sidebar-toggle svg {
    transform: rotate(180deg);
  }

  .sidebar-toggle:hover {
    background: var(--color-primary);
    color: var(--color-primary-dark);
  }

  .sidebar-icons {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 14px 9px;
    border-radius: 999px;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s ease;
  }

  .social-sidebar.is-collapsed .sidebar-icons {
    opacity: 0;
    transform: translateX(-60px);
    visibility: hidden;
    pointer-events: none;
  }

  .sidebar-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    transition: transform 150ms ease;
  }

  .sidebar-icon:hover {
    transform: scale(1.12);
  }

  .sidebar-icon svg,
  .sidebar-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media (max-width: 768px) {
    .social-sidebar {
      display: none;
    }
  }
</style>
