---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/global.css";

const pages = await getCollection("pages");
const aboutEntry = pages.find((entry) => entry.id === "about");

const { Content } = aboutEntry
  ? await render(aboutEntry)
  : { Content: null };

const title = aboutEntry?.data.title ?? "درباره ما";
---

<BaseLayout
  title={`${title} | صبا رسانه`}
  description="آشنایی با صبا رسانه، رسالت و رویکرد این رسانه خبری."
>
  <Header />

  <main class="about-page container">
    <header class="about-header">
      <span class="eyebrow">صبا رسانه</span>
      <h1>{title}</h1>
    </header>

    <div class="about-body">
      {Content ? <Content /> : <p>محتوایی یافت نشد.</p>}
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .about-page {
    padding-block: 50px 80px;
  }

  .about-header {
    margin-bottom: 30px;
  }

  .about-header .eyebrow {
    color: var(--color-primary-dark);
    font-weight: 700;
  }

  .about-header h1 {
    margin: 5px 0 0;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
  }

  .about-body {
    max-width: 760px;
    font-size: 1.05rem;
    line-height: 2.1;
  }

  .about-body :global(h2) {
    margin-top: 2rem;
    font-size: 1.3rem;
  }

  .about-body :global(p) {
    margin: 0 0 1.4rem;
  }
</style>
