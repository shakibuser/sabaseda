---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import NewsCard from "../../components/NewsCard.astro";
import "../../styles/global.css";

const news = (await getCollection("news")).sort(
  (a, b) =>
    new Date(b.data.publishedAt).getTime() -
    new Date(a.data.publishedAt).getTime()
);
---

<BaseLayout
  title="آرشیو اخبار | صبا رسانه"
  description="آرشیو کامل اخبار و گزارش‌های منتشرشده در صبا رسانه."
>
  <Header />

  <main class="archive-page container">
    <header class="archive-header">
      <span class="eyebrow">صبا رسانه</span>
      <h1>آرشیو اخبار</h1>
      <p>آخرین اخبار و گزارش‌های منتشرشده در صبا رسانه</p>
    </header>

    {news.length > 0 ? (
      <div class="archive-grid">
        {news.map((item) => (
          <NewsCard
            title={item.data.title}
            summary={item.data.summary}
            category={item.data.category}
            date={item.data.publishedAt}
            image={item.data.image}
            imageAlt={item.data.imageAlt}
            href={`/news/${item.id}/`}
          />
        ))}
      </div>
    ) : (
      <p class="empty">هنوز خبری منتشر نشده است.</p>
    )}
  </main>

  <Footer />
</BaseLayout>

<style>
  .archive-page {
    padding-block: 50px 80px;
  }

  .archive-header {
    margin-bottom: 30px;
  }

  .archive-header .eyebrow {
    color: var(--color-primary-dark);
    font-weight: 700;
  }

  .archive-header h1 {
    margin: 5px 0 0;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
  }

  .archive-header p {
    margin: 10px 0 0;
    color: var(--color-text-muted);
  }

  .archive-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 28px;
  }

  .empty {
    padding: 35px 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 700px) {
    .archive-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
