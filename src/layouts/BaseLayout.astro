---
import Seo from "../components/Seo.astro";
import AccessibilityWidget from "../components/AccessibilityWidget.astro";
import SocialSidebar from "../components/SocialSidebar.astro";
import ScrollToTop from "../components/ScrollToTop.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title = "صبا رسانه | صدای حقیقت، مطالبه عدالت",
  description = "صبا رسانه، رسانه‌ای خبری و مطالبه‌گر برای پیگیری حقیقت، عدالت و حقوق اجتماعی.",
  canonical,
  image,
  type = "website",
  publishedTime,
  modifiedTime
} = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://sabaseda.ir";

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "NewsMediaOrganization",
  name: "صبا رسانه",
  url: siteUrl,
  logo: {
    "@type": "ImageObject",
    url: new URL("/images/logo/logo.png", siteUrl).toString()
  },
  sameAs: ["https://t.me/saba_rasanehh"]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "صبا رسانه",
  url: siteUrl,
  inLanguage: "fa-IR"
};
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />

    <script is:inline>
      (function () {
        var scale = localStorage.getItem("saba-a11y-font-scale");
        if (scale) document.documentElement.style.fontSize = scale + "%";
        if (localStorage.getItem("saba-a11y-bold") === "on") {
          document.documentElement.classList.add("a11y-bold");
        }
      })();
    </script>

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="theme-color"
      content="#ffffff"
    />

    <link
      rel="icon"
      href="/favicon.svg"
    />

    <link
      rel="apple-touch-icon"
      href="/images/logo/logo.png"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    />

    <Seo
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />

    <slot name="head" />
  </head>

  <body>
    <slot />

    <SocialSidebar />
    <ScrollToTop />
    <AccessibilityWidget />

    <script
      type="module"
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "7e0065217ddf42b38430ef2dd91af59e"}'
    ></script>
  </body>
</html>
