---
import Seo from "../components/Seo.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title = "صبا رسانه | صدای حقیقت، مطالبه عدالت",
  description = "صبا رسانه، رسانه‌ای خبری و مطالبه‌گر برای پیگیری حقیقت، عدالت و حقوق اجتماعی.",
  canonical,
  image,
  type = "website",
  publishedTime,
  modifiedTime
} = Astro.props;
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="theme-color"
      content="#ffffff"
    />

    <link
      rel="icon"
      href="/favicon.svg"
    />

    <Seo
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />

    <slot name="head" />
  </head>

  <body>
    <slot />
  </body>
</html>
